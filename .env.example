# Environment variables for self-hosting.
# Copy to .env and fill in with your own values.

# ---- Supabase (your own project) ----
# Get from your Supabase project dashboard.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_publishable_key

# ---- Anthropic Claude API ----
# Get from https://console.anthropic.com (Settings -> API Keys).
# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ---- Stripe ----
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# ---- Firecrawl (optional, for listing scraping) ----
FIRECRAWL_API_KEY=fc-...

# ---- Twilio (optional, for SMS marketplace) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
